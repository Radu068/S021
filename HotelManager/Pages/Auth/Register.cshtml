@page
@model HotelManager.Pages.Auth.RegisterModel

@{
    ViewData["Title"] = "Înregistrare";
}

<div class="auth-layout">
    <section class="auth-card">
        <a class="back-link" asp-page="/Index">
            ← Înapoi acasă
        </a>

        <span class="eyebrow">BUN VENIT</span>
        <h1>Un cont nou.</h1>

        <p class="auth-intro">
            Completează datele și pregătește următorul sejur.
        </p>

        <form method="post"
              asp-antiforgery="true"
              data-submit-form>

            <input asp-for="ReturnUrl" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 role="alert"></div>

            <div class="form-row">
                <div class="field">
                    <label asp-for="Input.FirstName"
                           class="form-label"></label>

                    <input asp-for="Input.FirstName"
                           class="form-control"
                           autocomplete="given-name"
                           maxlength="50"
                           required />

                    <span asp-validation-for="Input.FirstName"></span>
                </div>

                <div class="field">
                    <label asp-for="Input.LastName"
                           class="form-label"></label>

                    <input asp-for="Input.LastName"
                           class="form-control"
                           autocomplete="family-name"
                           maxlength="50"
                           required />

                    <span asp-validation-for="Input.LastName"></span>
                </div>
            </div>

            <div class="field">
                <label asp-for="Input.Email"
                       class="form-label"></label>

                <input asp-for="Input.Email"
                       class="form-control"
                       autocomplete="email"
                       autocapitalize="none"
                       spellcheck="false"
                       maxlength="254"
                       required />

                <span asp-validation-for="Input.Email"></span>
            </div>

            <div class="field">
                <label asp-for="Input.Password"
                       class="form-label"></label>

                <input asp-for="Input.Password"
                       class="form-control"
                       autocomplete="new-password"
                       minlength="15"
                       maxlength="128"
                       required />

                <p class="form-text">
                    Între 15 și 128 de caractere.
                </p>

                <span asp-validation-for="Input.Password"></span>
            </div>

            <div class="field">
                <label asp-for="Input.ConfirmPassword"
                       class="form-label"></label>

                <input asp-for="Input.ConfirmPassword"
                       class="form-control"
                       autocomplete="new-password"
                       maxlength="128"
                       required />

                <span asp-validation-for="Input.ConfirmPassword"></span>
            </div>

            <button class="btn btn-primary w-100"
                    type="submit"
                    data-submit-button>
                Creează contul
                <span class="button-spinner" aria-hidden="true"></span>
            </button>
        </form>

        <p class="auth-switch">
            Ai deja cont?

            <a asp-page="/Auth/Login"
               asp-route-returnUrl="@Model.ReturnUrl">
                Autentifică-te
            </a>
        </p>
    </section>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
}